FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=travel_expense
MYSQL_USER=travel_user
MYSQL_PASSWORD=travel_password

CORS_ORIGINS=http://localhost:5173
UPLOAD_FOLDER=uploads/receipts
# Max upload size in bytes (25 MB) — covers documents/images. Large videos
# should be shared as a link (Google Drive / YouTube), not uploaded.
MAX_CONTENT_LENGTH=26214400

# Cloudflare R2 (object storage for uploaded bills). Set all five to make
# uploads durable so the finance department can view bills on ephemeral hosting.
# Leave blank to store bills on the local disk instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public r2.dev URL or a custom domain, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=

# Email notifications (Gmail SMTP). Set these to email the salesperson when
# finance approves or reimburses their expense. MAIL_PASSWORD must be a Gmail
# "App Password" (Google account → Security → 2-Step Verification → App
# passwords), NOT your normal password. Leave blank to disable.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
